# Copy to `.env` before running compose if you need a company proxy or internal registries.
#
# Example:
# HTTP_PROXY=http://proxy.company.local:8080
# HTTPS_PROXY=http://proxy.company.local:8080
# NO_PROXY=localhost,127.0.0.1,backend,frontend,redis,nginx
#
# Optional internal registries:
# NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
# Oracle example:
# PIP_INDEX_URL=https://pypi.org/simple
# PIP_TRUSTED_HOST=pypi.org files.pythonhosted.org
#
# NPM_CONFIG_STRICT_SSL=false
# NODE_TLS_REJECT_UNAUTHORIZED=0

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,backend,frontend,redis,nginx
NPM_CONFIG_REGISTRY=
NPM_CONFIG_STRICT_SSL=true
NODE_TLS_REJECT_UNAUTHORIZED=1
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
