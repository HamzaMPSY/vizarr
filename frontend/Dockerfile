FROM node:20-alpine AS build

WORKDIR /app

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG NPM_CONFIG_REGISTRY
ARG NPM_CONFIG_STRICT_SSL
ARG NODE_TLS_REJECT_UNAUTHORIZED

ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}
ENV NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY:-https://registry.npmjs.org/}
ENV NPM_CONFIG_STRICT_SSL=${NPM_CONFIG_STRICT_SSL:-true}
ENV NODE_TLS_REJECT_UNAUTHORIZED=${NODE_TLS_REJECT_UNAUTHORIZED:-1}
ENV npm_config_loglevel=verbose

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build

FROM node:20-alpine AS dev

WORKDIR /app

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ARG NPM_CONFIG_REGISTRY
ARG NPM_CONFIG_STRICT_SSL
ARG NODE_TLS_REJECT_UNAUTHORIZED

ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}
ENV NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY:-https://registry.npmjs.org/}
ENV NPM_CONFIG_STRICT_SSL=${NPM_CONFIG_STRICT_SSL:-true}
ENV NODE_TLS_REJECT_UNAUTHORIZED=${NODE_TLS_REJECT_UNAUTHORIZED:-1}
ENV npm_config_loglevel=verbose

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
