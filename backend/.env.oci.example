USE_SYNTHETIC_DATA=false
STORAGE_BACKEND=oci_zarr
APP_NAME=Vizarr OCI API
APP_ENVIRONMENT=development
APP_PORT=8000
AUTH_ENABLED=false
# Comma-separated API keys. Use key=dataset_id_a|dataset_id_b for dataset-scoped keys.
# In production, set APP_ENVIRONMENT=production and provide at least one key.
AUTH_API_KEYS=
REDIS_URL=redis://redis:6379/0
TILE_CACHE_TTL=3600
TILE_CACHE_DISPLAY_RANGE_DECIMALS=3
TILE_CACHE_CUSTOM_RANGE_ENABLED=true
DIRECT_TILE_MAX_PARALLEL_CHUNK_READS=8
# 0 disables each direct tile budget. Set positive values to fail oversized direct source renders with HTTP 503.
DIRECT_TILE_MAX_OBJECT_GETS=0
DIRECT_TILE_MAX_BYTE_RANGE_GETS=0
DIRECT_TILE_MAX_OBJECT_BYTES=0
DIRECT_TILE_MAX_ZARR_CHUNKS=0
DIRECT_TILE_MAX_SHARD_INDEX_READS=0
OCI_TEXT_CACHE_MAX_ENTRIES=256
OCI_BYTES_CACHE_MAX_ENTRIES=128
OCI_BYTES_CACHE_MAX_BYTES=134217728
ZARR_SHARD_INDEX_CACHE_ENTRIES=4096
ZARR_SHARD_INDEX_CACHE_BYTES=67108864
COLORMAP_DEFAULT=viridis
# auto chooses resource principals in OCI runtimes, API-key profiles when the
# profile has user/key_file and no security_token_file, otherwise security token.
# For autonomous local/VM runs prefer api_key, instance_principal, or resource_principal.
OCI_AUTH_MODE=auto
OCI_CONFIG_PROFILE=
OCI_CONFIG_FILE=/home/app/.oci/config
OCI_NAMESPACE=
OCI_BUCKET=
OCI_PREFIX=
OCI_BROWSE_PREFIX_ROOT=browse
OCI_MULTISCALE_PREFIX_ROOT=multiscale
OCI_DATASET_ID=
OCI_DATASET_NAME=
OCI_DATASET_DESCRIPTION=
OCI_ZARR_PATH=
OCI_ZARR_CONSOLIDATED=true
BROWSE_PREWARM_ENABLED=true
BROWSE_PREWARM_ALL_VARIABLES=false
