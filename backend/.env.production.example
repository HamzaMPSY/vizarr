USE_SYNTHETIC_DATA=true
STORAGE_BACKEND=synthetic
APP_NAME=Vizarr API
APP_ENVIRONMENT=production
AUTH_ENABLED=true
AUTH_API_KEYS=
CORS_ALLOWED_ORIGINS=https://viewer.example.com
CORS_ALLOWED_METHODS=GET,POST,HEAD,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,X-API-Key,Content-Type,Range,If-None-Match,If-Modified-Since
API_KEY_RATE_LIMIT_PER_MINUTE=120
API_KEY_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=redis://redis:6379/0
TILE_CACHE_TTL=3600
JOB_STORE_TTL=86400
COLORMAP_DEFAULT=viridis

# Copy this file to backend/.env.production for a real production-style run.
# Keep private OCI settings in the copied file or deployment secrets.
# On OCI compute, prefer instance_principal. For local production drills use
# api_key or a refreshed security_token profile intentionally.
OCI_AUTH_MODE=instance_principal
OCI_CONFIG_PROFILE=
OCI_CONFIG_FILE=/home/app/.oci/config
OCI_NAMESPACE=
OCI_BUCKET=
OCI_PREFIX=
OCI_DATASET_ID=
OCI_DATASET_NAME=
OCI_DATASET_DESCRIPTION=
OCI_ZARR_PATH=
OCI_ZARR_CONSOLIDATED=true
